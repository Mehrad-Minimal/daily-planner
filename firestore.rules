rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only touch their own tasks, and every write is validated.
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title', 'day', 'time', 'color', 'done'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.color in ['blue', 'green', 'orange', 'pink', 'purple']
        && request.resource.data.done is bool
        && (
          request.resource.data.time == null
          || (request.resource.data.time is string
              && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        );
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
